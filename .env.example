# =========================================================
# Bike Route Generator — configuration (docker compose)
# Copy this file to .env and fill in the values before running
# `docker compose up`.
# =========================================================

# ---- Database ----
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=bike_routes
DB_PORT=5432

# ---- Backend ----
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- Frontend ----
FRONTEND_PORT=3000
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---- Routing providers ----
# OpenRouteService (primary): free tier, 2000 req/day (directions),
# 500 req/day (round_trip/optimization). https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# GraphHopper (fallback, used only if ORS is unreachable or its quota is
# exhausted): free tier, 500 req/day. https://www.graphhopper.com/dashboard/
GRAPHHOPPER_API_KEY=

# ---- Points of interest / enrichment (all optional) ----
# OpenTripMap: free tier, 1000 req/day, adds POI photos.
# https://opentripmap.io/product
OPENTRIPMAP_API_KEY=

# Mapillary: free tier, street-level imagery coverage (not yet surfaced in
# the UI — reserved for a future "street preview" feature).
# https://www.mapillary.com/developer
MAPILLARY_API_KEY=

# Thunderforest (OpenCycleMap tiles): free tier, 150k tiles/month. Only
# needed if you swap the default raster OSM basemap for a cycling-specific
# style. https://www.thunderforest.com/pricing/
THUNDERFOREST_API_KEY=

# RideWithGPS: route-creation API requires a registered developer app key.
# Optional — without it, RideWithGPS falls back to "download GPX and import
# manually" in the navigation panel. https://ridewithgps.com/api
RIDEWITHGPS_API_KEY=

# Overpass API / Open-Elevation: public instances, no key required, but
# rate-limited. Override if you self-host your own instance.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup
